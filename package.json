{
  "name": "thrustbook",
  "productName": "Thrustbook",
  "version": "2.1.1",
  "description": "Rocket Development, Testing & Engineering Analysis Platform",
  "author": {
    "name": "Thrustbook",
    "email": "engineering@thrustbook.local"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DVVagram/Thrustbook.git"
  },
  "homepage": "https://github.com/DVVagram/Thrustbook#readme",
  "bugs": {
    "url": "https://github.com/DVVagram/Thrustbook/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:app": "node scripts/build.mjs",
    "build": "npm run build:app && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:layout": "node scripts/layout-check.mjs",
    "check": "npm run typecheck && npm run build && npm run check:layout",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
